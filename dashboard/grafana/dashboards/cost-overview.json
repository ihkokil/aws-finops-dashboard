        {
          "expr": "aws_finops_monthly_waste_dollars{category=\"total\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
